# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# TMDB_READ_ACCESS_TOKEN: Server-side TMDB v4 Bearer Read Access Token.
# Never expose this token in client-side code.
# Obtain at https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=""

# Firebase Client Configuration (Loaded automatically via firebase-applet-config.json)
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_APP_ID=""
