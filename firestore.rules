rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Security Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerifiedOwner(uid) {
      return isOwner(uid) && request.auth.token.email_verified == true;
    }

    function isOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isOptionalNumber(data, field) {
      return !(field in data) || (data[field] is number);
    }

    // --- Entity Validation Blueprints ---
    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && isOptionalString(data, 'email', 200)
        && isOptionalString(data, 'photoURL', 500)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchlistItem(data, uid, mediaId) {
      return data.keys().hasAll(['uid', 'mediaId', 'mediaType', 'title', 'addedAt'])
        && data.keys().hasOnly(['uid', 'mediaId', 'mediaType', 'title', 'posterPath', 'releaseYear', 'voteAverage', 'tmdbId', 'malId', 'addedAt'])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.mediaId is string && data.mediaId == mediaId && isValidId(data.mediaId)
        && data.mediaType is string && data.mediaType in ['movie', 'tv', 'anime']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && isOptionalString(data, 'posterPath', 500)
        && isOptionalString(data, 'releaseYear', 10)
        && isOptionalNumber(data, 'voteAverage')
        && isOptionalNumber(data, 'tmdbId')
        && isOptionalNumber(data, 'malId')
        && data.addedAt is timestamp;
    }

    function isValidWatchProgressItem(data, uid, mediaId) {
      return data.keys().hasAll(['uid', 'mediaId', 'mediaType', 'title', 'currentTime', 'duration', 'progressPercent', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'mediaId', 'mediaType', 'title', 'posterPath', 'backdropPath', 'tmdbId', 'malId', 'season', 'episode', 'subOrDub', 'currentTime', 'duration', 'progressPercent', 'completed', 'updatedAt'])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.mediaId is string && data.mediaId == mediaId && isValidId(data.mediaId)
        && data.mediaType is string && data.mediaType in ['movie', 'tv', 'anime']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && isOptionalString(data, 'posterPath', 500)
        && isOptionalString(data, 'backdropPath', 500)
        && isOptionalNumber(data, 'tmdbId')
        && isOptionalNumber(data, 'malId')
        && isOptionalNumber(data, 'season')
        && isOptionalNumber(data, 'episode')
        && (!( 'subOrDub' in data ) || (data.subOrDub is string && data.subOrDub in ['sub', 'dub']))
        && data.currentTime is number && data.currentTime >= 0
        && data.duration is number && data.duration >= 0
        && data.progressPercent is number && data.progressPercent >= 0 && data.progressPercent <= 100
        && (!( 'completed' in data ) || (data.completed is bool))
        && data.updatedAt is timestamp;
    }

    function isValidHistoryItem(data, uid, historyId) {
      return data.keys().hasAll(['uid', 'historyId', 'mediaId', 'mediaType', 'title', 'watchedAt'])
        && data.keys().hasOnly(['uid', 'historyId', 'mediaId', 'mediaType', 'title', 'posterPath', 'tmdbId', 'malId', 'season', 'episode', 'watchedAt'])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.historyId is string && data.historyId == historyId && isValidId(data.historyId)
        && data.mediaId is string && isValidId(data.mediaId)
        && data.mediaType is string && data.mediaType in ['movie', 'tv', 'anime']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && isOptionalString(data, 'posterPath', 500)
        && isOptionalNumber(data, 'tmdbId')
        && isOptionalNumber(data, 'malId')
        && isOptionalNumber(data, 'season')
        && isOptionalNumber(data, 'episode')
        && data.watchedAt is timestamp;
    }

    function isValidPreferences(data, uid) {
      return data.keys().hasAll(['uid', 'theme', 'language', 'autoplayNext', 'preferredAnimeAudio', 'saveSearchHistory', 'saveWatchHistory', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'theme', 'language', 'autoplayNext', 'preferredAnimeAudio', 'saveSearchHistory', 'saveWatchHistory', 'updatedAt'])
        && data.uid is string && data.uid == uid && isValidId(data.uid)
        && data.theme is string && data.theme in ['light', 'dark']
        && data.language is string && data.language.size() >= 2 && data.language.size() <= 16
        && data.autoplayNext is bool
        && data.preferredAnimeAudio is string && data.preferredAnimeAudio in ['sub', 'dub']
        && data.saveSearchHistory is bool
        && data.saveWatchHistory is bool
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // Connection health check document (read-only)
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) && isValidId(uid);
      allow list: if false;

      allow create: if isVerifiedOwner(uid)
        && isValidId(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedOwner(uid)
        && isValidId(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt']);

      allow delete: if isVerifiedOwner(uid) && isValidId(uid);

      match /watchlist/{mediaId} {
        allow get: if isOwner(uid) && isValidId(uid) && isValidId(mediaId);
        allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;

        allow create: if isVerifiedOwner(uid)
          && isValidId(uid)
          && isValidId(mediaId)
          && isValidWatchlistItem(incoming(), uid, mediaId)
          && incoming().addedAt == request.time;

        allow update: if false;

        allow delete: if isVerifiedOwner(uid) && isValidId(uid) && isValidId(mediaId);
      }

      match /watchProgress/{mediaId} {
        allow get: if isOwner(uid) && isValidId(uid) && isValidId(mediaId);
        allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;

        allow create: if isVerifiedOwner(uid)
          && isValidId(uid)
          && isValidId(mediaId)
          && isValidWatchProgressItem(incoming(), uid, mediaId)
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedOwner(uid)
          && isValidId(uid)
          && isValidId(mediaId)
          && isValidWatchProgressItem(incoming(), uid, mediaId)
          && incoming().uid == existing().uid
          && incoming().mediaId == existing().mediaId
          && incoming().mediaType == existing().mediaType
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'posterPath', 'backdropPath', 'tmdbId', 'malId',
            'season', 'episode', 'subOrDub', 'currentTime', 'duration',
            'progressPercent', 'completed', 'updatedAt'
          ]);

        allow delete: if isVerifiedOwner(uid) && isValidId(uid) && isValidId(mediaId);
      }

      match /history/{historyId} {
        allow get: if isOwner(uid) && isValidId(uid) && isValidId(historyId);
        allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;

        allow create: if isVerifiedOwner(uid)
          && isValidId(uid)
          && isValidId(historyId)
          && isValidHistoryItem(incoming(), uid, historyId)
          && incoming().watchedAt == request.time;

        allow update: if false;

        allow delete: if isVerifiedOwner(uid) && isValidId(uid) && isValidId(historyId);
      }

      match /preferences/{prefId} {
        allow get: if isOwner(uid) && isValidId(uid) && prefId == 'settings';
        allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;

        allow create: if isVerifiedOwner(uid)
          && isValidId(uid)
          && prefId == 'settings'
          && isValidPreferences(incoming(), uid)
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedOwner(uid)
          && isValidId(uid)
          && prefId == 'settings'
          && isValidPreferences(incoming(), uid)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'theme', 'language', 'autoplayNext', 'preferredAnimeAudio',
            'saveSearchHistory', 'saveWatchHistory', 'updatedAt'
          ]);

        allow delete: if isVerifiedOwner(uid) && isValidId(uid) && prefId == 'settings';
      }
    }
  }
}
